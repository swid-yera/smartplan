# Keycloak value
KEYCLOAK_URL=https://keycloak.org
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=eduplan
KEYCLOAK_CLIENT_SECRET=client_secret
GROUP_ID=keycloak-students-group-id
TEACHER_GROUP_ID=teacher_group_id
TEACHER_ROLES=Teacher
ADMIN_ROLES=Admins,Adminstrators
METHODIST_ROLES=Methodist

# Server value
SERVER_PORT=8080
COOKIE_DOMAIN=domain.com
BASE_URL=https://domain.com/api
FRONTEND_URL=https://domain.com

# Redis value
RedisAddr=localhost:6379
RedisPassword=
RedisDB=0

# Postgres value
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=eduplan
SSLMODE=disable
DATABASE_URL_DEV=postgresql://admin:admin@localhost:5432/eduplandev?sslmode=disable
DATABASE_URL=postgresql://admin:admin@localhost:5432/eduplan?sslmode=disable

# Minio S3
MINIO_ENDPOINT=s3.domain.com
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin
MINIO_BUCKET_NAME=eduplan
MINIO_USE_SSL=true

# Document render
DOCUMENT_RENDER_URL=https://domain.com/render
DOCUMENT_RENDER_API_KEY=

# Kripto integration
KRIPTO_BASE_URL=https://kripto.domain.com/back
KRIPTO_AUTH_TOKEN=kripto-token
KRIPTO_TIMEOUT_SECONDS=10
KRIPTO_MAX_RETRIES=2
KRIPTO_SERVICE_CLIENT=
GEMINI_API_KEY="gemini api key"
