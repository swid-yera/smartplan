# Keycloak value
KEYCLOAK_URL=https://keycloak.org
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=eduplan
KEYCLOAK_CLIENT_SECRET=client_secret
GROUP_ID=keycloak-students-group-id
TEACHER_GROUP_ID=teacher_group_id
TEACHER_ROLES=Teacher
ADMIN_ROLES=Admins,Adminstrators
METHODIST_ROLES=Methodist
SPECIAL_ROLES=Special

# Server value
SERVER_PORT=8080
COOKIE_DOMAIN=domain.com
BASE_URL=https://domain.com/api
FRONTEND_URL=https://domain.com

# Redis value
RedisAddr=localhost:6379
RedisPassword=
RedisDB=0

# Postgres value
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=eduplan
SSLMODE=disable
DATABASE_URL_DEV=postgresql://admin:admin@localhost:5432/eduplandev?sslmode=disable
DATABASE_URL=postgresql://admin:admin@localhost:5432/eduplan?sslmode=disable

# Minio S3
MINIO_ENDPOINT=s3.domain.com
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin
MINIO_BUCKET_NAME=eduplan
MINIO_USE_SSL=true

# Document render
DOCUMENT_RENDER_URL=https://domain.com/render
DOCUMENT_RENDER_API_KEY=

# Kripto integration
KRIPTO_BASE_URL=https://kripto.domain.com/back
KRIPTO_AUTH_TOKEN=kripto-token
KRIPTO_TIMEOUT_SECONDS=10
KRIPTO_MAX_RETRIES=2
KRIPTO_SERVICE_CLIENT=
# Gemini (single key or multiple fallback keys)
GEMINI_API_KEY="gemini api key"
# GEMINI_API_KEY_1="gemini api key 1"
# GEMINI_API_KEY_2="gemini api key 2"
# GEMINI_API_KEY_3="gemini api key 3"
# GEMINI_API_KEY_4="gemini api key 4"
# GEMINI_API_KEY_5="gemini api key 5"
GEMINI_PRIMARY_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL_1=gemini-2.5-flash
GEMINI_FALLBACK_MODEL_2=gemini-3.5-flash
GEMINI_FALLBACK_MODEL_3=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL_4=gemini-3-flash
GEMINI_FALLBACK_MODEL_5=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL_6=gemma-4-31b-it

# AI Provider Configuration
# Choose between "gemini" or "openai" (for OmniRoute or other OpenAI-compatible APIs)
AI_PROVIDER=gemini

# OpenAI / OmniRoute Configuration (используется если AI_PROVIDER=openai)
# Для локального OmniRoute используйте:
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_API_KEY=your-omniroute-api-key
# OPENAI_MODEL=kr/auto

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=kr/auto
