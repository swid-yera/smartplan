FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/models/.cache/huggingface
ENV TRANSFORMERS_CACHE=/models/.cache/huggingface

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        "ctranslate2>=4.5.0,<5.0.0" \
        "transformers>=4.45.0,<5.0.0" \
        "sentencepiece>=0.2.0,<0.3.0" \
        "protobuf>=5.0.0" \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY prepare-model-container.sh /usr/local/bin/prepare-model
RUN chmod +x /usr/local/bin/prepare-model

CMD ["prepare-model"]
